{
  "name": "mapo-backend",
  "version": "1.0.0",
  "description": "Mapo Business Manager Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "backup": "node scripts/backup.js backup",
    "restore": "node scripts/backup.js restore",
    "backup:list": "node scripts/backup.js list",
    "backup:schedule": "node scripts/backup.js schedule",
    "monitor": "node scripts/monitor.js monitor",
    "monitor:health": "node scripts/monitor.js health",
    "monitor:report": "node scripts/monitor.js report",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docker:build": "docker build -t mapo-backend .",
    "docker:run": "docker run -p 3001:3001 mapo-backend",
    "docker:compose": "docker-compose up -d"
  },
  "keywords": [
    "business",
    "management",
    "api",
    "mongodb",
    "express"
  ],
  "author": "Mapo Business Manager Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "express-validator": "^7.0.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
