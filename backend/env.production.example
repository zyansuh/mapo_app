# Production Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/mapo_business_manager_prod
MONGODB_TEST_URI=mongodb://localhost:27017/mapo_business_manager_test

# JWT Configuration
JWT_SECRET=your-production-super-secret-jwt-key-here-change-this
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-production-session-secret-here

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Monitoring
ENABLE_MONITORING=true
MONITORING_ENDPOINT=/health

# External APIs
KAKAO_REST_API_KEY=your-kakao-api-key-here
